{
  "name": "betterzalo-patcher",
  "version": "0.1.0",
  "description": "ZaPatch — Windows-only standalone CLI patcher for BetterZalo (ships as ZaPatch.exe)",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "zapatch": "src/main.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "menu": "node src/main.js menu",
    "test": "node --test test/*.test.js",
    "build:exe": "bun build --compile src/main.js --outfile dist/ZaPatch.exe"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "os": [
    "win32"
  ]
}
